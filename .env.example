APP_NAME="Olsangola Corporation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=olsangola
DB_USERNAME=ols_user
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@olsangola.ao"
MAIL_FROM_NAME="Olsangola Corporation"

# S3 / Cloudflare R2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=olsangola-files
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Sanctum — frontend domains (comma separated)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:3000,olsangola.ao,www.olsangola.ao

FRONTEND_URL=http://localhost:5173

# Pusher / Laravel WebSockets
PUSHER_APP_ID=ols_app
PUSHER_APP_KEY=ols_key
PUSHER_APP_SECRET=ols_secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"

EXCHANGE_RATE_API_KEY=
